{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://p4p.example/schemas/announce-response.schema.json",
  "title": "P4P Announce Response",
  "type": "object",
  "additionalProperties": false,
  "required": ["status", "node_id"],
  "properties": {
    "status": {
      "type": "string",
      "const": "ok"
    },
    "node_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z]{2}-[a-z0-9]+(?:-[a-z0-9]+)*-\\d{3,}$"
    }
  }
}
