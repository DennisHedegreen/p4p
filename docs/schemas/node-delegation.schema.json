{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://p4p.example/schemas/node-delegation.schema.json",
  "title": "P4P Node Delegation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "root_public_key",
    "issued_at",
    "role",
    "capabilities",
    "signature"
  ],
  "properties": {
    "root_public_key": {
      "type": "string",
      "pattern": "^ed25519:"
    },
    "issued_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "role": {
      "type": "string",
      "enum": ["primary", "backup"]
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "enum": ["announce", "heartbeat"]
      }
    },
    "signature": {
      "type": "string",
      "pattern": "^ed25519:"
    }
  }
}
