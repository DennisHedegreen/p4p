{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://p4p.example/schemas/trust-claims.schema.json",
  "title": "P4P Trust Claim Status Response",
  "type": "object",
  "additionalProperties": false,
  "required": ["registry_version", "query_time", "registry_metadata", "records"],
  "properties": {
    "registry_version": {
      "type": "string",
      "const": "0.1"
    },
    "query_time": {
      "type": "string",
      "format": "date-time"
    },
    "registry_metadata": {
      "$ref": "registry-source.schema.json#/$defs/registryMetadata"
    },
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "issuer_registry_url",
          "issuer_registry_public_key",
          "node_id",
          "claims",
          "issued_at",
          "signature"
        ],
        "properties": {
          "issuer_registry_url": {
            "type": "string",
            "format": "uri"
          },
          "issuer_registry_public_key": {
            "type": "string",
            "pattern": "^ed25519:"
          },
          "node_id": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-z]{2}-[a-z0-9]+(?:-[a-z0-9]+)*-\\d{3,}$"
          },
          "claims": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "enum": ["reviewed", "verified"]
            }
          },
          "reason": {
            "type": "string"
          },
          "issued_at": {
            "type": "string",
            "format": "date-time"
          },
          "expires_at": {
            "type": "string",
            "format": "date-time"
          },
          "signature": {
            "type": "string",
            "pattern": "^ed25519:"
          }
        }
      }
    }
  }
}
