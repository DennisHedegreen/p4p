{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://p4p.example/schemas/order-request.schema.json",
  "title": "P4P Order Request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "customer_name",
    "customer_contact",
    "fulfillment",
    "items",
    "note",
    "client_version"
  ],
  "properties": {
    "customer_name": {
      "type": "string",
      "minLength": 1
    },
    "customer_contact": {
      "type": "string",
      "minLength": 1
    },
    "fulfillment": {
      "type": "string",
      "enum": ["pickup"]
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "quantity"],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "quantity": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    },
    "note": {
      "type": "string"
    },
    "client_version": {
      "type": "string",
      "minLength": 1
    }
  }
}
