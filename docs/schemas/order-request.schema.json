{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://p4p.example/schemas/order-request.schema.json",
  "title": "P4P Order Request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "client_request_id",
    "customer_name",
    "customer_contact",
    "fulfillment",
    "items",
    "note",
    "client_version"
  ],
  "properties": {
    "client_request_id": {
      "type": "string",
      "minLength": 16,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]+$"
    },
    "customer_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "customer_contact": {
      "type": "string",
      "minLength": 1,
      "maxLength": 254
    },
    "fulfillment": {
      "type": "string",
      "enum": ["pickup"]
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "quantity"],
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 64,
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "quantity": {
            "type": "integer",
            "minimum": 1,
            "maximum": 99
          }
        }
      }
    },
    "note": {
      "type": "string",
      "maxLength": 1000
    },
    "client_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    }
  }
}
