{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://p4p.example/schemas/menu.schema.json",
  "title": "P4P Menu",
  "type": "object",
  "additionalProperties": false,
  "required": ["currency", "updated_at", "items"],
  "properties": {
    "currency": {
      "type": "string",
      "pattern": "^[A-Z]{3}$",
      "description": "Three-letter currency code for all item prices in this menu."
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "description", "price", "category"],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string"
          },
          "price": {
            "type": "integer",
            "minimum": 0,
            "description": "Integer minor units in the menu currency. For DKK/EUR/USD, 6500 means 65.00."
          },
          "category": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
