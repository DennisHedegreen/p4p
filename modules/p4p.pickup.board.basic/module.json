{
  "module_id": "p4p.pickup.board.basic",
  "module_class": "operator_surface",
  "lane": "operator",
  "type": "pickup-board",
  "provider_id": "p4p.reference",
  "version": "0.1",
  "status": "test",
  "description": "Shows accepted and ready orders on a simple local board facing the pickup counter.",
  "visibility": "operator_only",
  "capabilities": ["render_pickup_board", "report_status"],
  "input_events": [
    "ORDER_ACCEPTED",
    "ORDER_STATUS_UPDATED",
    "ORDER_REJECTED",
    "PAYMENT_MODE_CHANGED"
  ],
  "output_events": [
    "OUTBOUND_ACTION_REQUESTED",
    "ACTION_COMPLETED",
    "RETRY_SCHEDULED"
  ],
  "permissions": [
    "read.order.summary",
    "read.order.status",
    "read.order.estimated_ready",
    "read.order.payment_method"
  ],
  "blocking_policy": "non_blocking",
