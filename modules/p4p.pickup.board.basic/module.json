  "idempotency_scope": "pickup_board_render",
  "failure_modes": ["NODE_CONNECTIVITY_LOST"],
  "required_configuration": ["pickup_board_target"],
  "requires": [],
  "data_access": [
    "order_summary",
    "order_status",
    "estimated_ready_time",
    "payment_method",
    "pickup_board_target"
  ],
  "entrypoint": null,
  "signature": null,
  "public_catalog": {
    "function": "Shows accepted or ready direct orders on a simple local pickup board near the counter.",
    "data_access_summary": "Order summary, public order status, estimated ready time, payment mode, and configured pickup-board target.",
    "trust_status": "reference operator surface",
    "readiness": "test",
    "operator_status": "builtin local counter surface when enabled and configured"
  }
}
