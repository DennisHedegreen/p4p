  "idempotency_scope": "order_print",
  "failure_modes": [
    "PRINT_FAILED_PRECHECK",
    "PRINT_UNCERTAIN",
    "PRINTER_OFFLINE",
    "PAPER_LOW",
    "PAPER_OUT",
    "PAPER_JAM",
    "PRINT_TIMEOUT"
