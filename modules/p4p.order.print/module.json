  "required_configuration": ["printer_target"],
  "requires": [],
  "data_access": ["order_items", "note", "customer_contact", "fulfillment_type"],
  "entrypoint": null,
  "signature": null,
  "public_catalog": {
    "function": "Prints or forwards accepted test orders to a restaurant-owned printer/POS surface.",
    "data_access_summary": "Order items, note, customer contact, and fulfillment type.",
