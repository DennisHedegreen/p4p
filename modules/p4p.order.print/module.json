{
  "module_id": "p4p.order.print",
  "module_class": "printer",
  "lane": "operator",
  "type": "order-routing",
  "provider_id": "p4p.reference",
  "version": "0.1",
  "status": "planned",
  "description": "Prints or forwards accepted test orders to a restaurant-owned printer or POS surface.",
  "visibility": "operator_only",
  "capabilities": ["print_order", "report_status"],
  "input_events": ["ORDER_ACCEPTED", "PRINT_REQUESTED"],
  "output_events": [
    "PRINT_SUCCESS_CONFIRMED",
    "PRINT_FAILED_PRECHECK",
    "PRINT_UNCERTAIN",
    "PRINTER_OFFLINE",
    "PAPER_LOW",
    "PAPER_OUT",
    "PAPER_JAM",
    "PRINT_TIMEOUT"
  ],
  "permissions": [
    "read.order.summary",
    "read.order.items",
    "read.order.note"
