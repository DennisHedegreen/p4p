P4P_REGISTRY_URL=https://registry-b.pizza4people.com
P4P_BACKUP_REGISTRIES=[{"tier":0,"url":"https://registry-b.pizza4people.com"},{"tier":1,"url":"https://registry-a.pizza4people.com"}]
P4P_REGISTRY_DB_PATH=/var/lib/p4p/registry-b.sqlite3
P4P_REGISTRY_KEY_FILE=/var/lib/p4p/registry-b-key.json
