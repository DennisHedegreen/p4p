[Unit]
Description=P4P Registry
After=network-online.target
Wants=network-online.target

[Service]
User=p4p
Group=p4p
WorkingDirectory=/opt/p4p/registry
EnvironmentFile=/etc/p4p/registry.env
ExecStart=/opt/p4p/registry/.venv/bin/uvicorn main:app --host 127.0.0.1 --port 8000
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/var/lib/p4p

[Install]
WantedBy=multi-user.target
