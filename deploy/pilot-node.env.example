P4P_NODE_BASE_URL=https://node.example-restaurant.dk
P4P_REGISTRY_URLS=https://registry-a.pizza4people.com,https://registry-b.pizza4people.com

P4P_NODE_ID=dk-city-kebab-001
P4P_NODE_NAME=Example Kebab
P4P_NODE_LAT=55.6517
P4P_NODE_LNG=12.4126
P4P_NODE_COUNTRY=DK
P4P_NODE_CITY=Brondby
P4P_NODE_CATEGORIES=kebab

P4P_NODE_OPEN=true
P4P_NODE_ORDER_MODE=menu_only
P4P_NODE_MODULES=p4p.payment.cash
# P4P_HARDWARE_PROFILE=operator_screen

# Optional pilot hardware test lanes
# P4P_NODE_MODULES=p4p.payment.cash,p4p.order.print.backup,p4p.order.alert.basic,p4p.pickup.board.basic
# P4P_BACKUP_PRINT_TARGET=backup_printer
# P4P_BACKUP_PRINT_DRIVER=file_spool
# P4P_BACKUP_PRINT_SPOOL_DIR=/var/lib/p4p/backup-print-spool
# P4P_ALERT_TARGET=counter_bell
# P4P_ALERT_MODE=completed
# P4P_PICKUP_BOARD_TARGET=counter_screen
#
# For the full five-place pilot variants, read:
# deploy/pilot-node.five-place-presets.env.example

P4P_PILOT_NODE_DB_PATH=/var/lib/p4p/pilot-node.sqlite3
P4P_NODE_KEY_FILE=/var/lib/p4p/pilot-node-key.json

# Replace before live. Store this env file with chmod 600.
P4P_OPERATOR_TOKEN=replace-with-a-long-random-secret
