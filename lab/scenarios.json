  "registry_profiles": {
    "main-open": {
      "id": "main-open",
      "title": "Main open registry",
      "description": "Main uncurated local registry for raw P4P discoverability.",
      "service_name": "primary-registry",
      "role": "main-open",
      "curation_mode": "open",
      "availability_role": "primary",
      "scope": {
        "network": "local-open",
        "geography": "DK",
        "family": "shop"
      },
      "upstreams": [],
      "announce_policy": "direct",
      "discover_policy": "raw",
      "notes": [
        "This is the broad local discover surface for anything that announces into the main lane.",
        "No curation claim is made at the registry binary level in this lab pass."
      ]
    },
    "main-open-backup": {
      "id": "main-open-backup",
      "title": "Main open backup",
      "description": "Availability backup for the main open registry.",
      "service_name": "backup-registry",
      "role": "main-open",
      "curation_mode": "open",
      "availability_role": "backup",
      "backup_for": "main-open",
      "scope": {
        "network": "local-open",
        "geography": "DK",
        "family": "shop"
      },
      "upstreams": [
        "main-open"
      ],
      "announce_policy": "direct",
      "discover_policy": "raw",
      "notes": [
        "This lane is about availability, not a different meaning."
      ]
    },
    "dk-p4p-curated": {
      "id": "dk-p4p-curated",
      "title": "DK Pizza4People curated",
      "description": "Local curated Pizza4People DK sub-registry lane.",
      "service_name": "secondary-registry",
      "role": "sub-curated",
      "curation_mode": "curated",
      "availability_role": "primary",
      "scope": {
        "network": "pizza4people-dk",
        "geography": "DK",
        "family": "pizza4people"
      },
      "upstreams": [
        "main-open"
      ],
      "announce_policy": "allowlist_or_direct",
      "discover_policy": "filtered",
      "notes": [
        "This models a smaller branded public world than the main open registry.",
        "The lab UI treats this as a curated lane even though the registry runtime still speaks the same protocol."
      ]
    },
    "dk-p4p-curated-backup": {
      "id": "dk-p4p-curated-backup",
      "title": "DK Pizza4People curated backup",
      "description": "Availability backup for the curated Pizza4People DK lane.",
