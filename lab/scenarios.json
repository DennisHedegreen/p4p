      "role": "sub-curated",
      "curation_mode": "curated",
      "availability_role": "backup",
      "backup_for": "dk-p4p-curated",
      "scope": {
        "network": "pizza4people-dk",
        "geography": "DK",
        "family": "pizza4people"
      },
      "upstreams": [
        "dk-p4p-curated",
        "main-open"
      ],
      "announce_policy": "allowlist_or_direct",
      "discover_policy": "filtered",
      "notes": [
        "This lane is the backup of the curated meaning-layer, not of the open registry."
      ]
    }
  },
