{
  "version": "0.2-lab-v2",
  "services": {
    "primary-registry": {
      "name": "primary-registry",
      "kind": "registry",
      "description": "Primary local registry on port 8000.",
      "cwd": "{registry_root}",
      "command": [
        "{registry_python}",
        "-m",
        "uvicorn",
        "main:app",
        "--host",
        "127.0.0.1",
        "--port",
        "8000"
      ],
      "env": {
        "P4P_REGISTRY_URL": "http://127.0.0.1:8000",
        "P4P_BACKUP_REGISTRIES": "[{\"tier\":0,\"url\":\"http://127.0.0.1:8000\"},{\"tier\":1,\"url\":\"http://127.0.0.1:8001\"},{\"tier\":2,\"url\":\"http://127.0.0.1:8002\"}]"
      },
      "port": 8000,
      "health_url": "http://127.0.0.1:8000/registry-info",
      "links": [
        {
          "label": "Registry info",
          "url": "http://127.0.0.1:8000/registry-info",
          "description": "Shows primary registry identity and backup configuration."
        },
        {
          "label": "Primary discover",
          "url": "http://127.0.0.1:8000/discover?lat=55.6517&lng=12.4126&radius=50&category=pizza&country=DK",
          "description": "Checks discoverability through the primary registry."
        }
      ]
    },
